<Window x:Class="AgsCopy.App.ActivityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AgsCopy.App"
        Style="{StaticResource AppWindow}"
        Width="1100" Height="680" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,12,16,6">
            <StackPanel>
                <TextBlock x:Name="Heading" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="Summary" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock x:Name="PhaseText" TextWrapping="Wrap" Style="{StaticResource Hint}" />
                <ItemsControl x:Name="WalksList" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Style="{StaticResource Hint}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{l:T activity.close}" Click="Close_Click" />
                <CheckBox x:Name="FollowBox" Content="{l:T activity.follow}" IsChecked="True" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Margin="12,0,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" MinHeight="100" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="ProcessGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF0F3" BorderBrush="{StaticResource Border}" RowHeight="26">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:T activity.col.part}" Binding="{Binding Label}" Width="170" />
                    <DataGridTextColumn Header="{l:T activity.col.state}" Binding="{Binding State}" Width="110" />
                    <DataGridTextColumn Header="{l:T activity.col.files}" Binding="{Binding Files}" Width="80" />
                    <DataGridTextColumn Header="{l:T activity.col.bytes}" Binding="{Binding Bytes}" Width="85" />
                    <DataGridTextColumn Header="{l:T activity.col.errors}" Binding="{Binding Errors}" Width="60" />
                    <DataGridTextColumn Header="{l:T activity.col.time}" Binding="{Binding Time}" Width="70" />
                    <DataGridTextColumn Header="{l:T activity.col.current}" Binding="{Binding Current}" Width="*" FontFamily="Consolas" />
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent" />
            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top" Text="{l:T activity.lines}" FontWeight="SemiBold" Margin="0,4,0,4" />
                <TextBox x:Name="LinesBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
