<Window x:Class="AgsCopy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AgsCopy.App"
        Style="{StaticResource AppWindow}"
        Title="AGS-Copy" Width="1280" Height="780" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Accent}" BorderBrush="{StaticResource Brand}" BorderThickness="0,0,0,3" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{l:T main.language}" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="LanguageBox" Width="110" SelectionChanged="Language_Changed">
                        <ComboBoxItem Tag="it" Content="Italiano" />
                        <ComboBoxItem Tag="en" Content="English" />
                    </ComboBox>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="HeaderTitle" Text="AGS-Copy" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{l:T main.subtitle}" Foreground="#B8BEC6" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Service not running -->
        <Border x:Name="OfflineBanner" DockPanel.Dock="Top" Background="{StaticResource DangerLight}" Padding="16,8" Visibility="Collapsed">
            <TextBlock x:Name="OfflineText" Text="{l:T err.service}" Foreground="{StaticResource Danger}" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>

        <!-- Newer version on GitHub -->
        <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Background="{StaticResource AccentLight}" Padding="16,6" Visibility="Collapsed">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="UpdateInstallButton" Content="{l:T update.install}" Style="{StaticResource PrimaryButton}" Click="UpdateInstall_Click" />
                    <Button Content="{l:T update.notes}" Click="UpdateNotes_Click" />
                </StackPanel>
                <TextBlock x:Name="UpdateText" Foreground="{StaticResource Accent}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Scheduler paused -->
        <Border x:Name="PausedBanner" DockPanel.Dock="Top" Background="{StaticResource WarningLight}" Padding="16,8" Visibility="Collapsed">
            <TextBlock Text="{l:T main.pausedbanner}" Foreground="{StaticResource Warning}" FontWeight="SemiBold" />
        </Border>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,8">
            <WrapPanel>
                <Button x:Name="NewButton" Content="{l:T main.new}" Style="{StaticResource PrimaryButton}" Click="New_Click" />
                <Button x:Name="DuplicateButton" Content="{l:T main.duplicate}" Click="Duplicate_Click" />
                <Button x:Name="DeleteButton" Content="{l:T main.delete}" Click="Delete_Click" />
                <Separator Margin="6,0,12,0" />
                <Button x:Name="RunButton" Content="{l:T main.run}" Click="Run_Click" />
                <Button x:Name="StopButton" Content="{l:T main.stop}" Click="Stop_Click" />
                <Button x:Name="ActivityButton" Content="{l:T main.activity}" Click="Activity_Click" />
                <Button x:Name="HistoryButton" Content="{l:T main.history}" Click="History_Click" />
                <Button x:Name="RestoreButton" Content="{l:T main.restore}" Click="Restore_Click" />
                <Button x:Name="ReportButton" Content="{l:T main.report}" Click="Report_Click" />
                <Separator Margin="6,0,12,0" />
                <ToggleButton x:Name="PauseButton" Content="{l:T main.pause}" Padding="12,5" Click="Pause_Click" />
            </WrapPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,4">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Jobs, each with its pages, like the backup sets of Uranium -->
            <TreeView x:Name="JobTree" BorderThickness="0" Background="{StaticResource Surface}" Padding="4,6"
                      SelectedItemChanged="JobTree_SelectedItemChanged">
                <TreeView.Resources>
                    <!-- Grey selection, as in the editor's lists: the system blue made the grey lines under the name unreadable. -->
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E2E5E9" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E2E5E9" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black" />
                    <!-- Jobs and pages alike: selection and expansion follow the nodes. -->
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="Padding" Value="2,3" />
                    </Style>
                    <HierarchicalDataTemplate DataType="{x:Type l:JobRow}" ItemsSource="{Binding Pages}">
                        <Grid Width="240" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#B0B7C0" VerticalAlignment="Top" Margin="0,5,0,0" ToolTip="{Binding StateText}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding StateText}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding StateText}" />
                                <TextBlock Text="{Binding NextRunLine}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                <ProgressBar Height="4" Margin="0,2,0,0" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                             IsIndeterminate="{Binding Indeterminate, Mode=OneWay}" Foreground="{StaticResource Brand}"
                                             Background="{StaticResource Border}" BorderThickness="0"
                                             Visibility="{Binding Running, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                        <HierarchicalDataTemplate.Triggers>
                            <DataTrigger Binding="{Binding StateKey}" Value="Running">
                                <Setter TargetName="Dot" Property="Fill" Value="#1F6FB2" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StateKey}" Value="Success">
                                <Setter TargetName="Dot" Property="Fill" Value="#2E7D32" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StateKey}" Value="Warning">
                                <Setter TargetName="Dot" Property="Fill" Value="#E08A00" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StateKey}" Value="Failed">
                                <Setter TargetName="Dot" Property="Fill" Value="#C62828" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StateKey}" Value="Cancelled">
                                <Setter TargetName="Dot" Property="Fill" Value="#E08A00" />
                            </DataTrigger>
                        </HierarchicalDataTemplate.Triggers>
                    </HierarchicalDataTemplate>
                    <DataTemplate DataType="{x:Type l:PageNode}">
                        <TextBlock Text="{Binding Title}" Margin="2,1" />
                    </DataTemplate>
                </TreeView.Resources>
            </TreeView>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource Border}" />

            <!-- The selected job, or a new one -->
            <ContentControl x:Name="EditorHost" Grid.Column="2" />

            <StackPanel x:Name="EmptyState" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="EmptyTitle" Text="{l:T main.empty.title}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyText" Text="{l:T main.empty.text}" Style="{StaticResource Hint}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420" />
                <Button Content="{l:T main.new}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="New_Click" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
