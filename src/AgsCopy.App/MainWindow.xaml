<Window x:Class="AgsCopy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AgsCopy.App"
        Style="{StaticResource AppWindow}"
        Title="AGS-Copy" Width="1150" Height="640" MinWidth="820" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Accent}" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{l:T main.language}" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="LanguageBox" Width="110" SelectionChanged="Language_Changed">
                        <ComboBoxItem Tag="it" Content="Italiano" />
                        <ComboBoxItem Tag="en" Content="English" />
                    </ComboBox>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="AGS-Copy" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{l:T main.subtitle}" Foreground="#D6E6F5" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Service not running -->
        <Border x:Name="OfflineBanner" DockPanel.Dock="Top" Background="{StaticResource DangerLight}" Padding="16,8" Visibility="Collapsed">
            <TextBlock Text="{l:T err.service}" Foreground="{StaticResource Danger}" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>

        <!-- Scheduler paused -->
        <Border x:Name="PausedBanner" DockPanel.Dock="Top" Background="{StaticResource WarningLight}" Padding="16,8" Visibility="Collapsed">
            <TextBlock Text="{l:T main.pausedbanner}" Foreground="{StaticResource Warning}" FontWeight="SemiBold" />
        </Border>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,8">
            <WrapPanel>
                <Button x:Name="NewButton" Content="{l:T main.new}" Style="{StaticResource PrimaryButton}" Click="New_Click" />
                <Button x:Name="EditButton" Content="{l:T main.edit}" Click="Edit_Click" />
                <Button x:Name="DuplicateButton" Content="{l:T main.duplicate}" Click="Duplicate_Click" />
                <Button x:Name="DeleteButton" Content="{l:T main.delete}" Click="Delete_Click" />
                <Separator Margin="6,0,12,0" />
                <Button x:Name="RunButton" Content="{l:T main.run}" Click="Run_Click" />
                <Button x:Name="StopButton" Content="{l:T main.stop}" Click="Stop_Click" />
                <Button x:Name="HistoryButton" Content="{l:T main.history}" Click="History_Click" />
                <Separator Margin="6,0,12,0" />
                <ToggleButton x:Name="PauseButton" Content="{l:T main.pause}" Padding="12,5" Click="Pause_Click" />
            </WrapPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,4">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" />
        </Border>

        <Grid>
            <DataGrid x:Name="JobsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF0F3"
                      BorderThickness="0" RowHeight="34" CanUserAddRows="False" Background="White"
                      SelectionChanged="Jobs_SelectionChanged" MouseDoubleClick="Jobs_DoubleClick">
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Padding" Value="6,0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DCEAF7" />
                                <Setter Property="Foreground" Value="Black" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="28">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="11" Height="11" x:Name="Dot" Fill="#B0B7C0" ToolTip="{Binding StateText}" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding StateKey}" Value="Running">
                                        <Setter TargetName="Dot" Property="Fill" Value="#1F6FB2" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StateKey}" Value="Success">
                                        <Setter TargetName="Dot" Property="Fill" Value="#2E7D32" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StateKey}" Value="Warning">
                                        <Setter TargetName="Dot" Property="Fill" Value="#E08A00" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StateKey}" Value="Failed">
                                        <Setter TargetName="Dot" Property="Fill" Value="#C62828" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StateKey}" Value="Cancelled">
                                        <Setter TargetName="Dot" Property="Fill" Value="#E08A00" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{l:T col.name}" Binding="{Binding Name}" Width="170" FontWeight="SemiBold" />
                    <DataGridTemplateColumn Header="{l:T col.mode}" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="Mode" Text="{Binding ModeText}" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding DeletesFiles}" Value="True">
                                        <Setter TargetName="Mode" Property="Foreground" Value="#C62828" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{l:T col.source}" Binding="{Binding Source}" Width="*" />
                    <DataGridTextColumn Header="{l:T col.destination}" Binding="{Binding Destination}" Width="*" />
                    <DataGridTextColumn Header="{l:T col.schedule}" Binding="{Binding ScheduleText}" Width="170" />
                    <DataGridTextColumn Header="{l:T col.next}" Binding="{Binding NextRunText}" Width="120" />
                    <DataGridTextColumn Header="{l:T col.state}" Binding="{Binding StateText}" Width="220" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="{l:T main.empty.title}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{l:T main.empty.text}" Style="{StaticResource Hint}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420" />
                <Button Content="{l:T main.new}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="New_Click" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
