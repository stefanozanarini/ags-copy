<Window x:Class="AgsCopy.App.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AgsCopy.App"
        Style="{StaticResource AppWindow}"
        Width="900" Height="680" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,12,16,6">
            <StackPanel>
                <TextBlock x:Name="Heading" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{l:T restore.hint}" Style="{StaticResource Hint}" />
                <TextBlock Text="{l:T restore.point}" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="PointBox" DisplayMemberPath="Text" SelectionChanged="Point_Changed" Width="420" HorizontalAlignment="Left" />
                <TextBlock Text="{l:T restore.point.hint}" Style="{StaticResource Hint}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel>
                <TextBlock Text="{l:T restore.target}" FontWeight="SemiBold" />
                <DockPanel Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" Content="{l:T endpoint.browse}" Click="Browse_Click" Margin="6,0,0,0" />
                    <TextBox x:Name="TargetBox" FontFamily="Consolas" />
                </DockPanel>
                <TextBlock Text="{l:T restore.target.hint}" Style="{StaticResource Hint}" />
                <CheckBox x:Name="OverwriteBox" Content="{l:T restore.overwrite}" Margin="0,0,0,8" />
                <ProgressBar x:Name="Bar" Height="6" Minimum="0" Maximum="100" Foreground="{StaticResource Brand}" Background="{StaticResource Selection}"
                             BorderThickness="0" Visibility="Collapsed" Margin="0,0,0,6" />
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="OpenButton" Content="{l:T restore.open}" Click="Open_Click" Visibility="Collapsed" />
                        <Button x:Name="RestoreButton" Content="{l:T restore.start}" Style="{StaticResource PrimaryButton}" Click="Restore_Click" />
                        <Button x:Name="CloseButton" Content="{l:T restore.close}" IsCancel="True" Click="Close_Click" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Grid Margin="16,0,16,8">
            <TreeView x:Name="Tree" BorderBrush="{StaticResource Border}">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type l:RestoreNode}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="{Binding Selectable, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding GlyphBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <TextBlock x:Name="Loading" Text="{l:T layout.loading}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
        </Grid>
    </DockPanel>
</Window>
