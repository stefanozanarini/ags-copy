<Window x:Class="AgsCopy.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AgsCopy.App"
        Style="{StaticResource AppWindow}"
        Width="1050" Height="520" MinWidth="700" MinHeight="300"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ReportButton" Content="{l:T history.report}" Style="{StaticResource PrimaryButton}" Click="Report_Click" IsEnabled="False" />
                <Button x:Name="LogButton" Content="{l:T history.log}" Click="Log_Click" IsEnabled="False" />
                <Button Content="{l:T history.refresh}" Click="Refresh_Click" />
            </StackPanel>
        </Border>
        <DataGrid x:Name="RunsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF0F3" BorderThickness="0" RowHeight="28"
                  SelectionChanged="Runs_SelectionChanged" MouseDoubleClick="Report_Click">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{l:T history.start}" Binding="{Binding Start}" Width="140" />
                <DataGridTextColumn Header="{l:T history.duration}" Binding="{Binding Duration}" Width="80" />
                <DataGridTemplateColumn Header="{l:T history.outcome}" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="T" Text="{Binding OutcomeText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding OutcomeKey}" Value="Success">
                                    <Setter TargetName="T" Property="Foreground" Value="#2E7D32" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding OutcomeKey}" Value="Warning">
                                    <Setter TargetName="T" Property="Foreground" Value="#B26A00" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding OutcomeKey}" Value="Cancelled">
                                    <Setter TargetName="T" Property="Foreground" Value="#B26A00" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding OutcomeKey}" Value="Failed">
                                    <Setter TargetName="T" Property="Foreground" Value="#C62828" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{l:T history.trigger}" Binding="{Binding Trigger}" Width="100" />
                <DataGridTextColumn Header="{l:T history.files}" Binding="{Binding Files}" Width="90" />
                <DataGridTextColumn Header="{l:T history.bytes}" Binding="{Binding Bytes}" Width="90" />
                <DataGridTextColumn Header="{l:T history.failed}" Binding="{Binding Failed}" Width="70" />
                <DataGridTextColumn Header="{l:T rep.archived}" Binding="{Binding Archived}" Width="80" />
                <DataGridTextColumn Header="{l:T history.code}" Binding="{Binding ExitCode}" Width="60" />
                <DataGridTextColumn Header="{l:T history.message}" Binding="{Binding Message}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
